<Bindings>
    <Binding name="FOREVERDUBBED_STOP" category="BINDING_HEADER_FOREVERDUBBED">
        ForeverDubbed_StopAudio();
    </Binding>
    <Binding name="FOREVERDUBBED_SKIP" category="BINDING_HEADER_FOREVERDUBBED">
        ForeverDubbed_SkipAudio();
    </Binding>
    <Binding name="FOREVERDUBBED_PAUSE" category="BINDING_HEADER_FOREVERDUBBED">
        ForeverDubbed_TogglePause();
    </Binding>
</Bindings>
