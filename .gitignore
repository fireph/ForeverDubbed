/dist/
*.exe
*.test
*.zip
*.dll
*.pdb
/.runtime/
__pycache__/
*.pyc

# Local recordings and model weights.
/audio_clips/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.safetensors
*.onnx
*.pt
*.pth

# Keep playable voice states; omit previews, references, metadata, experiments,
# backups, and incomplete exports. These exceptions must follow *.safetensors.
/tts/custom/*
!/tts/custom/*.safetensors
/tts/custom/*.pending.safetensors

# Local diagnostics, dialogue logs, and credentials.
/screenshots/
/capture*.png
/snapshot*.png
*.jsonl
*.log
.env
.env.*
!.env.example
